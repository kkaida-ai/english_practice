# AI の呼び出し方法: auto（既定）/ claude-code / api / ollama
#   auto        : ANTHROPIC_API_KEY があれば api、なければ claude-code（Claude Code CLI）、それもなければ ollama
#   claude-code : `claude -p` を使う。APIキー不要（Claude Code にログイン済みであること）
#   api         : Claude API（ANTHROPIC_API_KEY が必要）
#   ollama      : ローカルLLM（品質は下がる）
# EIKAIWA_BACKEND=auto

# claude-code のモデル（sonnet / haiku / opus）。haiku は速いが少し単純になる
# EIKAIWA_CLI_MODEL=sonnet
# EIKAIWA_EFFORT=low

# api を使う場合のみ
# ANTHROPIC_API_KEY=sk-ant-...
# EIKAIWA_MODEL=claude-opus-5

# ollama を使う場合のみ
# EIKAIWA_OLLAMA_MODEL=llama3.1:8b

# PORT=3000
# VOICEVOX_URL=http://127.0.0.1:50021

# リリーの声（Kokoro）
# EIKAIWA_PYTHON=python3
# KOKORO_PORT=50032
# KOKORO_AUTOSTART=1
