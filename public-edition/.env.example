# 会話AI の選択: groq（既定・無料・速い）/ claude-code（この PC の Claude Code・質が最も高い）/ ollama（PC 内）
# LLM_PROVIDER=groq

# Groq の API キー（https://console.groq.com/keys で無料発行・カード不要）
GROQ_API_KEY=

# claude-code のときのモデル（sonnet / haiku / opus）
# CLAUDE_CODE_MODEL=sonnet

# ずんだもんの英語のカナ読みの作り方: llm（会話AIに書かせる）/ g2p（発音辞書から規則で作る）
# 既定: claude-code のときは llm、それ以外は g2p
# ZUNDA_KANA=

# 合言葉（未設定なら自動で作って data/password.txt に保存）
# APP_PASSWORD=

# 任意設定
# LLM_MODEL=openai/gpt-oss-120b          # Groq のモデル
# LLM_FALLBACK_MODELS=openai/gpt-oss-20b  # 混雑時に切り替える予備モデル（カンマ区切り）
# LLM_BASE_URL=                          # OpenAI 互換の別サービスを使う場合
# LLM_API_KEY=
# DAILY_CHAT_LIMIT=900                   # 全員合計の1日の会話回数の上限（Groq 無料枠は1日1,000回）
# PORT=3000
# VOICEVOX_URL=http://127.0.0.1:50021
# VOICEVOX_ENGINE_PATH=
# EIKAIWA_PYTHON=python3
# KOKORO_PORT=50032
